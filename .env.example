# ==============================================================================
# DawaiSaathi (Medicine Buddy) - Environment Configuration
# ==============================================================================

# 1. Anthropic Claude API Configuration (Vision + Text)
# Get your API key from https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# 2. Supabase Postgres Configuration (Optional - app gracefully runs offline / demo mode if empty)
# Get these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# 3. Application URL (For production redirects / metadata)
NEXT_PUBLIC_APP_URL=https://dawaisaathi.vercel.app
